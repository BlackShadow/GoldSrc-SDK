#include <winresrc.h>

#define IDI_HLDS 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDI_HLDS ICON "hlds.ico"
1 RT_MANIFEST "hlds.manifest"

1 VERSIONINFO
FILEVERSION 4,1,1,1
PRODUCTVERSION 4,1,1,1
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Valve"
			VALUE "FileDescription", "HLDS Launcher"
			VALUE "FileVersion", "4, 1, 1, 1"
			VALUE "InternalName", "HLDS Launcher"
			VALUE "LegalCopyright", "Copyright (c) 1996-2003"
			VALUE "LegalTrademarks", ""
			VALUE "OriginalFilename", "hlds.exe"
			VALUE "ProductName", "HLDS Launcher"
			VALUE "ProductVersion", "4, 1, 1, 1"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
