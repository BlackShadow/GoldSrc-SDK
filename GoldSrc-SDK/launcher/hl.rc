#include <windows.h>

#define IDI_HALFLIFE 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_HALFLIFE ICON "hl.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,1
 PRODUCTVERSION 1,1,1,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Valve"
			VALUE "FileDescription", "Half-Life Launcher"
			VALUE "FileVersion", "1, 1, 1, 1"
			VALUE "InternalName", "Half-Life Launcher"
			VALUE "LegalCopyright", "Copyright (c) 1996-2003"
			VALUE "LegalTrademarks", ""
			VALUE "OriginalFilename", "hl.exe"
			VALUE "ProductName", "Steam Half-Life Launcher"
			VALUE "ProductVersion", "1, 1, 1, 1"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
