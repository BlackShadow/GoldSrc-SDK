<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\bin\$(Platform)\$(Configuration)\$(GameDirectory)\$(BinaryDirectory)\</OutDir>
    <IntDir>$(ProjectDir)..\..\bin\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ProcessorNumber>4</ProcessorNumber>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ProgramDataBaseFileName>$(IntDir)$(TargetName)-compile.pdb</ProgramDataBaseFileName>
      <PreprocessorDefinitions>WIN32;_WINDOWS;CLIENT_WEAPONS;_ITERATOR_DEBUG_LEVEL=0;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\$(SourceDirectory)\engine;$(ProjectDir)..\..\$(SourceDirectory)\dlls;$(ProjectDir)..\..\$(SourceDirectory)\dlls\bot;$(ProjectDir)..\..\$(SourceDirectory)\dlls\hostage;$(ProjectDir)..\..\$(SourceDirectory)\cl_dll;$(ProjectDir)..\..\$(SourceDirectory)\cl_dll\hl;$(ProjectDir)..\..\$(SourceDirectory)\cl_dll\VGUI;$(ProjectDir)..\..\$(SourceDirectory)\common;$(ProjectDir)..\..\$(SourceDirectory)\pm_shared;$(ProjectDir)..\..\$(SourceDirectory)\game_shared;$(ProjectDir)..\..\$(SourceDirectory)\game_shared\bot;$(ProjectDir)..\..\$(SourceDirectory)\public\vgui_controls;$(ProjectDir)..\..\$(SourceDirectory)\public;$(ProjectDir)..\..\$(SourceDirectory)\public\vgui;$(ProjectDir)..\..\$(SourceDirectory)\public\game_controls;$(ProjectDir)..\..\$(SourceDirectory)\vgui2\controls;$(ProjectDir)..\..\$(SourceDirectory)\vgui2\game_controls;$(ProjectDir)..\..\dlls;$(ProjectDir)..\..\common;$(ProjectDir)..\..\pm_shared;$(ProjectDir)..\..\game_shared;$(ProjectDir)..\..\game_shared\bot;$(ProjectDir)..\..\public;$(ProjectDir)..\..\engine;$(ProjectDir)..\..\vgui2\controls;$(ProjectDir)..\..\vgui2\src\public;$(ProjectDir)..\..\external;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ModuleDefinitionFile>$(ProjectDir)$(ProjectName).def</ModuleDefinitionFile>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(BinaryDirectory)'=='dlls'">
    <ClCompile>
      <PreprocessorDefinitions>VALVE_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(BinaryDirectory)'=='cl_dlls'">
    <ClCompile>
      <PreprocessorDefinitions>CLIENT_DLL;HL_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(ProjectDir)..\..\lib\public\SDL2.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(BinaryDirectory)'=='cl_dlls' and '$(SourceDirectory)'=='cstrike'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\external\steamworks;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(ProjectDir)..\..\lib\public\steam_api.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(BinaryDirectory)'=='cl_dlls' and '$(SourceDirectory)'=='czeror'">
    <Link>
      <AdditionalDependencies>ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
